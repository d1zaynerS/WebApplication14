{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",


  "RateLimiting": {
    "Fixed": {
      "PolicyName": "FixedPolicy",
      "PermitLimit": 5,
      "WindowSeconds": 10,
      "QueueLimit": 0
    }
  },
  "PaymentService": {
    "ApiUrl": "https://api.payments.com",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "EnableLogging": true
  }
}